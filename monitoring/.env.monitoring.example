# File biến cho docker-compose.monitoring.yml (phần GIÁM SÁT), chạy trên EC2.
# Copy thành .env.monitoring rồi điền giá trị thật (file thật KHÔNG lên git):
#   cp monitoring/.env.monitoring.example monitoring/.env.monitoring && chmod 600 monitoring/.env.monitoring
# Chạy: docker compose -f monitoring/docker-compose.monitoring.yml --env-file monitoring/.env.monitoring up -d
#
# Phần web (db/backend/frontend/nginx/exporter/alloy) dùng .env.app — xem
# .env.app.example. Hai phần nối nhau qua network Docker "ecommerce-shared".
# Mật khẩu: chỉ dùng chữ + số (tránh ' và $).

# ---- Prometheus ----
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# ---- Loki (log) ----
LOKI_RETENTION_PERIOD=168h
# Port Loki trên EC2, chỉ mở 127.0.0.1 để gỡ lỗi. Alloy đẩy log qua network nội bộ.
LOKI_PORT=3100

# ---- Grafana (dashboard, mở qua <web>/admin/grafana/) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_PORT=3001
# Địa chỉ đầy đủ người dùng gõ để vào Grafana (Grafana dùng để tạo link, chuyển trang)
GRAFANA_ROOT_URL=http://localhost/admin/grafana/
# Địa chỉ Alertmanager hiện trong link của tin cảnh báo
ALERTMANAGER_URL=http://localhost/admin/alertmanager/

# ---- Kênh gửi cảnh báo (Alertmanager) — phải bật ÍT NHẤT 1 kênh ----
# Telegram: token lấy từ @BotFather, chat id lấy theo README mục 7.15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail: để trống SMTP_HOST = tắt mail (README mục 7.14)
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
ALERT_EMAIL_TO=

# ---- HolmesGPT + AWS Bedrock (README mục 7.19) ----
# Mỗi lần hỏi = vài lượt gọi Bedrock, TÍNH PHÍ. Không có khoá thì AI không chạy.
BEDROCK_REGION=ap-southeast-1
# Model ID / inference profile ID, KHÔNG ghi tiền tố "bedrock/" (compose tự thêm)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Đăng nhập Bedrock: điền MỘT trong hai cách, để trống cách còn lại.
# Cách 1 — Bedrock API key (ABSK...):
AWS_BEARER_TOKEN_BEDROCK=
# Cách 2 — access key IAM (khoá tạm thì điền thêm AWS_SESSION_TOKEN):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- AI phân tích cảnh báo, gửi Telegram (holmes-bridge, README mục 7.20) ----
# Để trống = tắt. Bật: AI_WEBHOOK_URL=http://holmes-bridge:8080/alert
# (cần đủ khoá Bedrock ở trên + TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID)
AI_WEBHOOK_URL=
# Mức cảnh báo được AI phân tích (critical,warning hoặc chỉ critical)
AI_SEVERITIES=critical,warning
# Tối đa bao nhiêu lần phân tích mỗi giờ (mỗi lần = vài lượt gọi Bedrock, tính phí)
AI_MAX_PER_HOUR=6

# ---- AI đề xuất lệnh sửa lỗi, NGƯỜI duyệt trên Telegram (remediator, xem README2.md) ----
# Để trống = AI chỉ chẩn đoán như cũ. Bật: REMEDIATOR_URL=http://remediator:8090
# (cần bật service remediator + docker-proxy: profile "ai")
REMEDIATOR_URL=
# dry-run (mặc định, an toàn): duyệt xong chỉ ghi audit, KHÔNG chạy lệnh.  execute: chạy thật.
REMEDIATION_MODE=dry-run
# false = công tắc tắt khẩn cấp, từ chối mọi đề xuất mới
REMEDIATION_ENABLED=true
# Khoá ký nút Duyệt/Từ chối. Chỉ dùng chữ và số, dài >= 32 ký tự (ví dụ: openssl rand -hex 32)
REMEDIATOR_SECRET=
# Telegram user id được phép bấm Duyệt / gõ lệnh, cách nhau dấu phẩy. Chat riêng (id dương) để trống cũng được.
# Chat NHÓM (id âm) mà để trống thì remediator CHẶN mọi lệnh (vì ai trong nhóm cũng sẽ duyệt được), trừ khi
# đặt REMEDIATOR_ALLOW_ANY_GROUP_MEMBER=true (không khuyến khích).
REMEDIATOR_APPROVER_IDS=
# Số vòng AI tối đa cho 1 sự cố: lệnh chạy xong mà chưa ổn -> AI xem kết quả rồi đề xuất bước tiếp (người duyệt từng bước).
# Mỗi vòng = 1 lượt Bedrock (tính phí) và tính vào AI_MAX_PER_HOUR. 1 = tắt vòng lặp. Dừng giữa chừng: nút ⏹ hoặc gõ /stop.
AI_MAX_ROUNDS=3

# ---- Cách 2: AI gọi công cụ (đọc trạng thái + đề xuất lệnh), xem ai-remediation/README2.md ----
# Token chung giữa holmes-bridge, remediator và Alertmanager (chữ + số, >= 32 ký tự, ví dụ: openssl rand -hex 32).
# Có token thì MỌI endpoint nội bộ đều bắt xác thực (bridge /alert /continue /chat; remediator /propose /close /tool/*),
# Alertmanager tự gửi token kèm webhook AI. Trống = tool API tắt, AI quay về cách cũ (ghi 1 dòng chữ) và endpoint
# nội bộ KHÔNG xác thực (không khuyến khích). AI_USE_TOOLS=false để ép dùng cách cũ.
REMEDIATOR_TOOL_TOKEN=
AI_USE_TOOLS=true
