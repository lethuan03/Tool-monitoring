# Copy this file to .env and adjust values. The real .env is gitignored.
#
# Dùng cho cả docker-compose (biến ${...}) và chạy local (backend đọc qua dotenv).
# Mật khẩu: chỉ dùng chữ + số (tránh ' và $ — compose/SQL sẽ hiểu sai).

# ---- MySQL container (service: db) ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
# User riêng cho app (KHÔNG dùng root). Backend trong compose dùng user này.
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change_me_app
# User chỉ-đọc cho mysqld-exporter (tạo bởi mysql/init/01-exporter-user.sh)
MYSQL_EXPORTER_PASSWORD=change_me_exporter

# ---- Tài khoản admin của trang quản trị (/admin.html) ----
# Backend tự tạo tài khoản này ở LẦN CHẠY ĐẦU (khi DB chưa có admin).
# Mật khẩu tối thiểu 12 ký tự. Sau lần đầu, đổi mật khẩu trong trang quản trị
# (mục "Đổi mật khẩu"); sửa giá trị ở đây không còn tác dụng.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_12chars
# Phiên đăng nhập hết hạn sau bao nhiêu giờ
SESSION_TTL_HOURS=8

# ---- Prometheus ----
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# ---- Chỉ dùng khi chạy backend local (không Docker) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecommerce_app
DB_PASSWORD=change_me_app
DB_NAME=ecommerce

# ---- Public port của nginx (EC2: đặt 80) ----
HTTP_PORT=8080

# ---- HTTPS bằng Let's Encrypt (CHỈ dùng trên EC2, local để trống) ----
# Domain đã trỏ (bản ghi DNS A) về IP public của EC2, ví dụ shop.congty.com
DOMAIN=
# Email nhận thư báo khi cert sắp hết hạn mà gia hạn tự động bị lỗi
LETSENCRYPT_EMAIL=

# ---- Loki + Alloy (log) ----
# Giữ log bao lâu rồi xoá (168h = 7 ngày). Log nặng hơn metrics nên mặc định
# giữ ngắn hơn Prometheus.
LOKI_RETENTION_PERIOD=168h
# Mức log của backend: debug | info | warn | error
# Đặt debug để thấy cả log của /health và /metrics (request của máy)
LOG_LEVEL=info
# Port Loki trên máy (chỉ localhost, để gỡ lỗi)
LOKI_PORT=3100
# Port giao diện gỡ lỗi của Alloy (chỉ localhost)
ALLOY_PORT=12345

# ---- Grafana (dashboard) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
# Port mở Grafana trên máy (chỉ localhost)
GRAFANA_PORT=3001

# ---- Kênh gửi cảnh báo (Alertmanager) — phải bật ÍT NHẤT 1 kênh ----
# Telegram (README mục 7.15): token lấy từ @BotFather, chat id lấy theo README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail (README mục 7.14): để trống SMTP_HOST = tắt mail.
# Gmail: SMTP_HOST=smtp.gmail.com:587, SMTP_USERNAME = địa chỉ Gmail,
# SMTP_PASSWORD = "App password" 16 ký tự (KHÔNG phải mật khẩu đăng nhập Gmail).
# Test không cần Gmail: docker compose --profile mail-test up -d, rồi đặt
#   SMTP_HOST=mailpit:1025  SMTP_REQUIRE_TLS=false  SMTP_USERNAME= (để trống)
# và xem mail ở http://localhost:8025
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
# Ai nhận mail (nhiều người: cách nhau bằng dấu phẩy)
ALERT_EMAIL_TO=

# ---- HolmesGPT + AWS Bedrock (AI điều tra sự cố, README mục 7.19) ----
# Chỉ dùng khi chạy: docker compose run --rm holmes ask "..."
# Mỗi câu hỏi gọi Bedrock vài lần -> TÍNH PHÍ theo token. Không chạy thì không tốn.
#
# Region có model bạn đã bật quyền (Bedrock console -> Model access)
BEDROCK_REGION=us-east-1
# Model ID hoặc inference profile ID (KHÔNG ghi tiền tố "bedrock/", compose tự thêm).
# Xem danh sách: aws bedrock list-inference-profiles --region us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Đăng nhập Bedrock: điền MỘT trong hai cách, để trống cách còn lại.
# Cách 1 — Bedrock API key (Bedrock console -> API keys):
AWS_BEARER_TOKEN_BEDROCK=
# Cách 2 — access key IAM (chỉ cần quyền bedrock:InvokeModel*).
# Khoá tạm (SSO / assume role) thì điền thêm AWS_SESSION_TOKEN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
