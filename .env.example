# Copy this file to .env and adjust values. The real .env is gitignored.
#
# Dùng cho cả docker-compose (biến ${...}) và chạy local (backend đọc qua dotenv).
# Khi chạy local không Docker: đặt DB_HOST=localhost (hoặc host MySQL của bạn).
# Tránh ký tự '$' trong mật khẩu vì docker-compose sẽ hiểu nhầm là biến.

# ---- MySQL container (service: db) ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=change_me_user
MYSQL_PASSWORD=change_me_password

# ---- Backend DB connection (service: backend) ----
DB_HOST=db
DB_PORT=3306
DB_USER=change_me_user
DB_PASSWORD=change_me_password
DB_NAME=ecommerce
