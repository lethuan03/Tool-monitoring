# File biến cho docker-compose.monitoring.yml (phần GIÁM SÁT), chạy trên EC2.
# Copy thành .env.monitoring rồi điền giá trị thật (file thật KHÔNG lên git):
#   cp .env.monitoring.example .env.monitoring && chmod 600 .env.monitoring
# Chạy: docker compose -f docker-compose.monitoring.yml --env-file .env.monitoring up -d
#
# Phần web (db/backend/frontend/nginx/exporter/alloy) dùng .env.app — xem
# .env.app.example. Hai phần nối nhau qua network Docker "ecommerce-shared".
# Mật khẩu: chỉ dùng chữ + số (tránh ' và $).

# ---- Prometheus ----
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# ---- Loki (log) ----
LOKI_RETENTION_PERIOD=168h
# Port Loki trên EC2, chỉ mở 127.0.0.1 để gỡ lỗi. Alloy đẩy log qua network nội bộ.
LOKI_PORT=3100

# ---- Grafana (dashboard, mở qua <web>/admin/grafana/) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_PORT=3001
# Địa chỉ đầy đủ người dùng gõ để vào Grafana (Grafana dùng để tạo link, chuyển trang)
GRAFANA_ROOT_URL=http://localhost/admin/grafana/
# Địa chỉ Alertmanager hiện trong link của tin cảnh báo
ALERTMANAGER_URL=http://localhost/admin/alertmanager/

# ---- Kênh gửi cảnh báo (Alertmanager) — phải bật ÍT NHẤT 1 kênh ----
# Telegram: token lấy từ @BotFather, chat id lấy theo README mục 7.15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail: để trống SMTP_HOST = tắt mail (README mục 7.14)
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
ALERT_EMAIL_TO=

# ---- HolmesGPT + AWS Bedrock (README mục 7.19) ----
# Mỗi lần hỏi = vài lượt gọi Bedrock, TÍNH PHÍ. Không có khoá thì AI không chạy.
BEDROCK_REGION=ap-southeast-1
# Model ID / inference profile ID, KHÔNG ghi tiền tố "bedrock/" (compose tự thêm)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Đăng nhập Bedrock: điền MỘT trong hai cách, để trống cách còn lại.
# Cách 1 — Bedrock API key (ABSK...):
AWS_BEARER_TOKEN_BEDROCK=
# Cách 2 — access key IAM (khoá tạm thì điền thêm AWS_SESSION_TOKEN):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- AI phân tích cảnh báo, gửi Telegram (holmes-bridge, README mục 7.20) ----
# Để trống = tắt. Bật: AI_WEBHOOK_URL=http://holmes-bridge:8080/alert
# (cần đủ khoá Bedrock ở trên + TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID)
AI_WEBHOOK_URL=
# Mức cảnh báo được AI phân tích (critical,warning hoặc chỉ critical)
AI_SEVERITIES=critical,warning
# Tối đa bao nhiêu lần phân tích mỗi giờ (mỗi lần = vài lượt gọi Bedrock, tính phí)
AI_MAX_PER_HOUR=6
