    {
      "type": "timeseries",
      "id": 21,
      "title": "Request/giây theo mã trạng thái (từ log nginx)",
      "description": "Đếm từ access log của nginx, KHÔNG phải từ Prometheus. Hai nguồn này phải khớp nhau — lệch nhiều là dấu hiệu một bên đang mất dữ liệu.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (rate({service=\"nginx\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Thời gian xử lý từ log nginx (giây)",
      "description": "Tính trực tiếp từ trường request_time trong access log JSON. p95 = 95% khách được phục vụ nhanh hơn mức này.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"nginx\"} | json | __error__=\"\" | unwrap request_time [1m]) by ()",
          "legendFormat": "p95",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.50, {service=\"nginx\"} | json | __error__=\"\" | unwrap request_time [1m]) by ()",
          "legendFormat": "p50 (trung vị)",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "id": 23,
      "title": "Top đường dẫn được gọi nhiều nhất",
      "description": "Bóc trường `path` từ access log JSON ngay lúc truy vấn (`| json`). path KHÔNG được đặt làm nhãn vì có vô hạn giá trị — nhưng vẫn lọc/đếm được như thế này.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (path) (count_over_time({service=\"nginx\"} | json | __error__=\"\" [$__range])))",
          "legendFormat": "{{path}}",
          "queryType": "instant"
        }
      ],
      "transformations": [
