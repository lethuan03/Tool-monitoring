          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Backend p95 thời gian xử lý (ms, từ log)",
      "description": "Lấy từ trường duration_ms trong log JSON của backend. So với p95 của nginx: nếu nginx chậm hơn backend nhiều thì nút thắt nằm ở tầng proxy/mạng, không phải ở app.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"backend\"} | json | __error__=\"\" | unwrap duration_ms [1m]) by ()",
          "legendFormat": "p95 (ms)",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "row",
