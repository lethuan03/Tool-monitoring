# Chép thành .env.mergegate (đã chặn trong .gitignore) rồi điền giá trị thật.

# --- GitHub ---
GITHUB_REPO=owner/repo
# Fine-grained token chỉ cho repo này: Actions (Read and write), Contents, Pull requests, Commit statuses
# (Read and write). KHÔNG cấp Workflows. Dùng token riêng, không dùng chung với ci-logs.
GATE_GITHUB_TOKEN=

# --- Telegram: bot RIÊNG (dùng chung bot với remediator sẽ mất nút bấm) ---
GATE_TELEGRAM_BOT_TOKEN=
GATE_TELEGRAM_CHAT_ID=
# User id được bấm duyệt, cách nhau dấu phẩy. Bắt buộc nếu chat là nhóm.
GATE_APPROVER_IDS=

# --- Chế độ (mặc định an toàn) ---
# dry-run: không gắn status, không tạo PR, không merge. execute: làm thật.
GATE_MODE=dry-run
# off: không gọi AI (chỉ chạy kịch bản cơ bản). bedrock: gọi Bedrock, TÍNH PHÍ theo token.
GATE_AI=off

# --- Bedrock (chỉ cần khi GATE_AI=bedrock): dùng 1 trong 2 cách đăng nhập ---
BEDROCK_REGION=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Giới hạn ---
GATE_MAX_REVIEWS_PER_DAY=10
GATE_QUIET_SECONDS=120
GATE_POLL_SECONDS=60
GATE_IGNORE_BRANCHES=backup/*,test/*
