# File biến cho docker-compose.app.yml (phần WEB), chạy trên EC2.
# Copy thành .env.app rồi điền giá trị thật (file thật KHÔNG lên git):
#   cp .env.app.example .env.app && chmod 600 .env.app
# Chạy: docker compose -f docker-compose.app.yml --env-file .env.app up -d
#
# Phần giám sát (Prometheus/Grafana/Loki/Alertmanager/AI) dùng .env.monitoring —
# xem .env.monitoring.example. Hai phần nối nhau qua network "ecommerce-shared".
# Mật khẩu: chỉ dùng chữ + số (tránh ' và $).
# ---- MySQL container (service: db) ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change_me_app
MYSQL_EXPORTER_PASSWORD=change_me_exporter
# ---- Tài khoản admin trang quản trị (/admin.html) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_12chars
SESSION_TTL_HOURS=8
# ---- Backend ----
LOG_LEVEL=info
# ---- Public port của nginx (EC2: đặt 80) ----
HTTP_PORT=80
# ---- Alloy đẩy log sang Loki ----
# Để trống = http://ecommerce-loki:3100/loki/api/v1/push (Loki nằm trong
# docker-compose.monitoring.yml, nối qua network "ecommerce-shared").
LOKI_PUSH_URL=
# ---- Basic Auth riêng cho Grafana/Prometheus/Alertmanager qua nginx ----
# KHÔNG liên quan ADMIN_USERNAME/ADMIN_PASSWORD phía trên — tách riêng, hoạt
# động độc lập với MySQL, nên vẫn vào được dashboard khi DB có sự cố. nginx tự
# check Basic Auth (không gọi backend), nên MySQL chết cũng không ảnh hưởng.
MONITORING_BASIC_AUTH_USER=admin
MONITORING_BASIC_AUTH_PASSWORD=change_me_monitoring_12chars
